function caixaEletronico() {
  let saldo = 1000;
  let opcao;
  do {
    opcao = prompt("Escolha: 1-Depósito, 2-Saque, 3-Saldo, 4-Sair");
    if (opcao === "1") {
      let valor = parseFloat(prompt("Valor do depósito:"));
      saldo += valor;
    } else if (opcao === "2") {
      let valor = parseFloat(prompt("Valor do saque:"));
      if (valor > saldo) {
        console.log("Saldo insuficiente.");
      } else {
        saldo -= valor;
      }
    } else if (opcao === "3") {
      console.log("Saldo atual:", saldo);
    }
  } while (opcao !== "4");
}
